---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const CATEGORY_LABELS: Record<string, string> = {
  'japan-stock': '日本株',
  'us-stock': '米国株',
  'household': '家計',
};

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = allPosts.slice(0, 8);
const popular = allPosts.filter((p) => p.data.category === 'japan-stock').slice(0, 6);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="store">
      <!-- Hero: banner + headline (top page only) -->
      <section class="hero">
        <div class="hero-banner">
          <img
            src="/images/hero-banner.webp"
            alt="かけかぶマネーブログ — 未来のために、今できるお金のこと"
            width="1693"
            height="929"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <h1 class="store-headline">
          <span class="hl-dark">かけかぶマネーブログ</span>
          <span class="hl-gray">配当投資と家計改善の、リアルな記録</span>
        </h1>
      </section>

      <!-- Category chips -->
      <nav class="chip-row" aria-label="カテゴリ">
        <a href="/blog/" class="chip">
          <span class="chip-icon">📚</span>
          <span class="chip-label">すべての記事</span>
        </a>
        <a href="/blog/category/japan-stock/" class="chip">
          <span class="chip-icon">📈</span>
          <span class="chip-label">日本株</span>
        </a>
        <a href="/blog/category/us-stock/" class="chip">
          <span class="chip-icon">🌎</span>
          <span class="chip-label">米国株</span>
        </a>
        <a href="/blog/category/household/" class="chip">
          <span class="chip-icon">🏠</span>
          <span class="chip-label">家計</span>
        </a>
        <a href="/about/" class="chip">
          <span class="chip-icon chip-icon-brand">か</span>
          <span class="chip-label">このブログについて</span>
        </a>
      </nav>

      <!-- Latest carousel -->
      <section class="shelf">
        <h2 class="shelf-headline">
          <span class="hl-dark">最新記事</span>
          <span class="hl-gray">見逃せない、新しい発信</span>
        </h2>
        <div class="carousel">
          {latest.map((post) => (
            <a href={`/blog/${post.id}/`} class="card">
              {post.data.category && (
                <p class={`card-kicker kicker-${post.data.category}`}>
                  {CATEGORY_LABELS[post.data.category]}
                </p>
              )}
              <h3 class="card-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="card-desc">{post.data.description}</p>
              )}
              <time class="card-date"><FormattedDate date={post.data.pubDate} /></time>
            </a>
          ))}
          <a href="/blog/" class="card card-more">
            <p class="card-more-text">すべての記事を見る</p>
            <span class="card-more-arrow">→</span>
          </a>
        </div>
      </section>

      <!-- Japan stock carousel -->
      <section class="shelf">
        <h2 class="shelf-headline">
          <span class="hl-dark">日本高配当株</span>
          <span class="hl-gray">150銘柄を保有する私の、銘柄の選び方</span>
        </h2>
        <div class="carousel">
          {popular.map((post) => (
            <a href={`/blog/${post.id}/`} class="card">
              <p class="card-kicker kicker-japan-stock">日本株</p>
              <h3 class="card-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="card-desc">{post.data.description}</p>
              )}
              <time class="card-date"><FormattedDate date={post.data.pubDate} /></time>
            </a>
          ))}
        </div>
      </section>

      <!-- About banner -->
      <section class="about-banner">
        <div class="about-banner-icon">か</div>
        <div class="about-banner-body">
          <h2 class="about-banner-title">普通の会社員の、リアルな配当投資。</h2>
          <p class="about-banner-desc">
            投資歴10年。日本高配当株150銘柄と米国ETFで、月20万円の配当金生活を目指しています。
          </p>
          <a href="/about" class="btn-pill">詳しく読む</a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main.store {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3em 0 5em;
  }

  /* Two-tone headlines (Apple Store style) */
  .hl-dark { color: var(--text); }
  .hl-gray { color: var(--text-muted); }

  .hero {
    display: flex;
    align-items: center;
    gap: 2.5em;
    padding: 1.5em max(2em, calc((100% - 1040px) / 2)) 1.25em;
  }
  .hero-banner {
    flex: 1 1 56%;
    min-width: 0;
  }
  .hero-banner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
  }
  .hero .store-headline {
    flex: 1 1 44%;
    font-size: 1.55em;
  }
  .hero .store-headline .hl-dark {
    display: block;
    white-space: nowrap;
  }

  .store-head {
    padding: 1.5em max(2em, calc((100% - 1040px) / 2)) 1em;
  }
  .store-headline {
    font-size: 2.2em;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 21em;
  }

  /* Category chips */
  .chip-row {
    display: flex;
    gap: 1.25em;
    overflow-x: auto;
    padding: 1em max(2em, calc((100% - 1040px) / 2)) 1.5em;
    scrollbar-width: none;
  }
  .chip-row::-webkit-scrollbar { display: none; }
  .chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    flex-shrink: 0;
    transition: transform 0.2s var(--ease);
  }
  .chip:hover { transform: scale(1.04); text-decoration: none; }
  .chip-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bg-card);
    box-shadow: var(--shadow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7em;
  }
  .chip-icon-brand {
    background: linear-gradient(135deg, #0071E3 0%, #2997FF 100%);
    color: #fff;
    font-size: 1.3em;
    font-weight: 700;
  }
  .chip-label {
    font-size: 0.8em;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }

  /* Shelf (carousel section) */
  .shelf {
    margin-top: 2.5em;
  }
  .shelf-headline {
    font-size: 1.6em;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin: 0 0 0.9em;
    padding: 0 max(2em, calc((100% - 1040px) / 2));
  }

  .carousel {
    display: flex;
    gap: 1.25em;
    overflow-x: auto;
    padding: 0.5em max(2em, calc((100% - 1040px) / 2)) 1.5em;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .carousel::-webkit-scrollbar { display: none; }

  /* Cards */
  .card {
    flex: 0 0 320px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border-radius: 18px;
    padding: 1.75em 1.75em 1.5em;
    min-height: 240px;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }
  .card-kicker {
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin: 0 0 0.6em;
    text-transform: uppercase;
  }
  .kicker-japan-stock { color: #BF4800; }
  .kicker-us-stock { color: #0071E3; }
  .kicker-household { color: #059669; }
  .card-title {
    font-size: 1.1em;
    font-weight: 700;
    color: var(--text);
    line-height: 1.45;
    letter-spacing: -0.01em;
    margin: 0 0 0.5em;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-desc {
    font-size: 0.82em;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-date {
    margin-top: auto;
    padding-top: 1em;
    font-size: 0.75em;
    color: var(--text-light);
  }

  .card-more {
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    background: transparent;
    border: 2px dashed var(--border);
    box-shadow: none;
  }
  .card-more:hover {
    border-color: var(--accent);
    box-shadow: none;
  }
  .card-more-text {
    font-size: 0.95em;
    font-weight: 600;
    color: var(--accent);
    margin: 0;
  }
  .card-more-arrow {
    font-size: 1.4em;
    color: var(--accent);
  }

  /* About banner */
  .about-banner {
    margin: 3em max(2em, calc((100% - 1040px) / 2)) 0;
    background: var(--bg-card);
    border-radius: 24px;
    padding: 3em 2.5em;
    display: flex;
    align-items: center;
    gap: 2em;
    box-shadow: var(--shadow-xs);
  }
  .about-banner-icon {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0071E3 0%, #2997FF 100%);
    color: #fff;
    font-size: 2em;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 113, 227, 0.3);
  }
  .about-banner-title {
    font-size: 1.4em;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.4em;
  }
  .about-banner-desc {
    font-size: 0.9em;
    color: var(--text-muted);
    line-height: 1.8;
    margin: 0 0 1.2em;
  }
  .btn-pill {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 0.9em;
    font-weight: 500;
    padding: 0.6em 1.6em;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .btn-pill:hover {
    background: var(--accent-hover);
    transform: scale(1.03);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    main.store { padding: 1.5em 0 3em; }
    .hero {
      flex-direction: column;
      align-items: stretch;
      gap: 1.1em;
      padding: 0 1em 0.5em;
    }
    .hero-banner img { border-radius: 12px; }
    .hero .store-headline { font-size: 1.5em; }
    .store-headline { font-size: 1.5em; }
    .shelf-headline { font-size: 1.2em; }
    .card { flex: 0 0 260px; padding: 1.4em 1.4em 1.2em; min-height: 210px; }
    .chip-icon { width: 54px; height: 54px; font-size: 1.4em; }
    .about-banner {
      flex-direction: column;
      text-align: center;
      padding: 2em 1.5em;
      gap: 1.25em;
    }
  }
</style>
